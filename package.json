{
  "name": "maturita",
  "version": "1.0.0",
  "private": true,
  "description": "Educational maturita app: GTK 4 desktop client, Next.js web client, shared lesson content.",
  "scripts": {
    "content": "node tools/build-content.mjs",
    "web": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:install": "npm --prefix web install",
    "desktop": "make -C desktop run",
    "desktop:build": "make -C desktop"
  }
}
